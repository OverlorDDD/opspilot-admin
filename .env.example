# Local development defaults. Never commit real credentials.
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
JWT_SECRET=local-development-secret-change-before-production
RUNTIME_CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=/api
# Used by Next.js on the server, not sent to browsers.
INTERNAL_API_ORIGIN=http://127.0.0.1:4000
