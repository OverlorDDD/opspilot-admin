generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String           @map("password_hash")
  firstName          String           @map("first_name")
  lastName           String?          @map("last_name")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  memberships        WorkspaceMember[]
  createdRevisions   ConfigRevision[] @relation("RevisionCreatedBy")
  reviewedRevisions  ConfigRevision[] @relation("RevisionReviewedBy")
  publishedRevisions ConfigRevision[] @relation("RevisionPublishedBy")
  auditLogs          AuditLog[]       @relation("AuditActor")

  @@map("users")
}

enum WorkspaceRole {
  owner
  admin
  editor
  approver
  viewer
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  members   WorkspaceMember[]
  projects  Project[]
  auditLogs AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(viewer)
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum Environment {
  development
  staging
  production
}

enum ConfigKeyType {
  number
  boolean
  string
  json
}

enum ConfigRevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum AuditAction {
  CONFIG_CREATED
  DRAFT_CREATED
  DRAFT_UPDATED
  DRAFT_SUBMITTED
  DRAFT_APPROVED
  DRAFT_REJECTED
  CONFIG_PUBLISHED
}

model Project {
  id          String        @id
  workspaceId String?       @map("workspace_id")
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  configs        ConfigEntry[]
  dispatchTasks  DispatchTask[]
  dispatchEvents DispatchEvent[]

  @@map("projects")
}

model ConfigEntry {
  id          String           @id
  projectId   String           @map("project_id")
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment
  name        String
  type        ConfigKeyType
  value       Json
  description String           @default("")
  isPublished Boolean          @default(true) @map("is_published")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  revisions   ConfigRevision[]
  auditLogs   AuditLog[]

  @@unique([projectId, environment, name])
  @@index([projectId, environment])
  @@map("config_entries")
}

model ConfigRevision {
  id              String               @id @default(cuid())
  configEntryId   String               @map("config_entry_id")
  configEntry     ConfigEntry          @relation(fields: [configEntryId], references: [id], onDelete: Cascade)
  version         Int
  status          ConfigRevisionStatus @default(DRAFT)
  value           Json
  description     String               @default("")
  rejectionReason String?              @map("rejection_reason")
  createdById     String?              @map("created_by_id")
  createdBy       User?                @relation("RevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById    String?              @map("reviewed_by_id")
  reviewedBy      User?                @relation("RevisionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedById   String?              @map("published_by_id")
  publishedBy     User?                @relation("RevisionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  reviewedAt      DateTime?            @map("reviewed_at")
  publishedAt     DateTime?            @map("published_at")

  @@unique([configEntryId, version])
  @@index([configEntryId, status])
  @@map("config_revisions")
}

model AuditLog {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configEntryId String?      @map("config_entry_id")
  configEntry   ConfigEntry? @relation(fields: [configEntryId], references: [id], onDelete: SetNull)
  actorUserId   String?      @map("actor_user_id")
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action        AuditAction
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([configEntryId, createdAt])
  @@map("audit_logs")
}


enum DispatchTaskStatus {
  QUEUED
  IN_PROGRESS
  DONE
}

enum DispatchEventType {
  TASK_CREATED
  TASK_COMPLETED
  DIGEST_QUEUED
  CARRIER_SYNC_SUCCEEDED
  CARRIER_SYNC_FAILED
}

model DispatchTask {
  id        String             @id @default(cuid())
  projectId String             @map("project_id")
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    DispatchTaskStatus @default(QUEUED)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@map("dispatch_tasks")
}

model DispatchEvent {
  id        String            @id @default(cuid())
  projectId String            @map("project_id")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      DispatchEventType
  message   String
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("dispatch_events")
}
