DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
API_PORT=4000
# For public-tunnel sessions use API_HOST=127.0.0.1 (backend stays private).
API_HOST=0.0.0.0
JWT_SECRET=local-development-secret-change-before-production

REDIS_URL=redis://localhost:6379
RUNTIME_CACHE_TTL_SECONDS=60

# Comma-separated browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000
# false for local HTTP; true once the public site is behind HTTPS.
COOKIE_SECURE=false
